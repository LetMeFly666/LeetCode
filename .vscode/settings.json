{
    "files.associations": {
        "*.wxss": "css",
        "*.wxml": "html",
        ".commitmsg": "git-commit",
        ".commitTitleExtra": "git-commit",
        "_未收录.txt": "python",
    },
    "files.watcherExclude": {
        "**/AllProblems/**": true
    },
    "editor.mouseWheelZoom": true,
    "workbench.tree.enableStickyScroll": true,
    // copilot: https://docs.github.com/zh/copilot/how-tos/configure-personal-settings/configure-in-ide#%E9%92%88%E5%AF%B9%E7%89%B9%E5%AE%9A%E8%AF%AD%E8%A8%80%E5%90%AF%E7%94%A8%E6%88%96%E7%A6%81%E7%94%A8-github-copilot
    "github.copilot.enable": {
        "*": true,
        "go": false,
        "python": false,
        "cpp": false,
        "rust": false,
        "java": false,
        "markdown": true,
    }
}